# BM-Matic — nginx server block (PHP-FPM). Replace the domain, paths and PHP socket.
server {
    listen 80;
    listen [::]:80;
    server_name www.bm-matic.be bm-matic.be;
    return 301 https://www.bm-matic.be$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.bm-matic.be;

    ssl_certificate     /etc/letsencrypt/live/www.bm-matic.be/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.bm-matic.be/privkey.pem;

    # Document root is /public; app, config, storage and vendor are outside it.
    root /var/www/bm-matic/public;
    index index.php;
    server_tokens off;
    client_max_body_size 12m;

    # Hidden files (except .well-known)
    location ~ /\.(?!well-known/) { deny all; }

    # Uploads are data only: never execute scripts there
    location ^~ /uploads/ {
        location ~* \.(php|phtml|phar|pl|py|cgi|sh|html?|svg|js)$ { deny all; }
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox" always;
        try_files $uri =404;
    }

    # Versioned static assets
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Only the front controller is executed
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~ \.php$ { return 404; }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
}
