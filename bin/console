#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * GATE Lebanon command line. Run `php bin/console` for the list of commands.
 * Only the CLI SAPI is accepted; web requests get a 404 and nothing runs.
 */

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require dirname(__DIR__) . '/vendor/autoload.php';

/** @var list<string> $argv */
exit((new Gate\Console\Kernel())->run($argv));
